{
  "components": {
    "schemas": {
      "APIError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "nullable": true,
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "param": {
            "nullable": true,
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "param",
          "code"
        ],
        "type": "object"
      },
      "ChatMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "Plain text or a nonempty array of text parts. Images, audio, tool calls, and extra content-part fields are unsupported.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "$ref": "#/components/schemas/TextPart"
                },
                "minItems": 1,
                "type": "array"
              }
            ],
            "x-go-type": "json.RawMessage"
          },
          "role": {
            "enum": [
              "system",
              "developer",
              "user",
              "assistant"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [
          "content",
          "role"
        ],
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "minItems": 1,
            "type": "array"
          },
          "model": {
            "description": "Use codex or copilot for the CLI's configured default, or an exact ID from GET /v1/models such as `codex/\u003cnative-model-id\u003e`.",
            "example": "codex",
            "type": "string"
          },
          "n": {
            "default": 1,
            "description": "Only one completion is supported; omit this field or use 1.",
            "example": 1,
            "maximum": 1,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "reasoning_effort": {
            "description": "Optional reasoning effort forwarded to the CLI. Supported levels depend on the selected native model; omission preserves its default.",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "type": "string",
            "x-go-type": "string"
          },
          "stream": {
            "default": false,
            "description": "When true, return incremental server-sent events instead of a buffered JSON response.",
            "nullable": true,
            "type": "boolean"
          },
          "stream_options": {
            "$ref": "#/components/schemas/StreamOptions"
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "type": "object"
      },
      "Chunk": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/components/schemas/ChunkChoice"
            },
            "type": "array"
          },
          "created": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "enum": [
              "chat.completion.chunk"
            ],
            "type": "string",
            "x-go-type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "choices",
          "created",
          "id",
          "model",
          "object"
        ],
        "type": "object"
      },
      "ChunkChoice": {
        "additionalProperties": false,
        "properties": {
          "delta": {
            "$ref": "#/components/schemas/Delta"
          },
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "tool_calls",
              "content_filter",
              "function_call"
            ],
            "nullable": true,
            "type": "string",
            "x-go-type": "string"
          },
          "index": {
            "type": "integer"
          }
        },
        "required": [
          "delta",
          "index"
        ],
        "type": "object"
      },
      "Completion": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "$ref": "#/components/schemas/CompletionChoice"
            },
            "type": "array"
          },
          "created": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "object": {
            "enum": [
              "chat.completion"
            ],
            "type": "string",
            "x-go-type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "choices",
          "created",
          "id",
          "model",
          "object"
        ],
        "type": "object"
      },
      "CompletionChoice": {
        "additionalProperties": false,
        "properties": {
          "finish_reason": {
            "enum": [
              "stop",
              "length",
              "tool_calls",
              "content_filter",
              "function_call"
            ],
            "type": "string",
            "x-go-type": "string"
          },
          "index": {
            "type": "integer"
          },
          "message": {
            "$ref": "#/components/schemas/ResponseMessage"
          }
        },
        "required": [
          "finish_reason",
          "index",
          "message"
        ],
        "type": "object"
      },
      "Delta": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "nullable": true,
            "type": "string"
          },
          "role": {
            "enum": [
              "developer",
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/APIError"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "Model": {
        "additionalProperties": false,
        "properties": {
          "created": {
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "object": {
            "enum": [
              "model"
            ],
            "type": "string",
            "x-go-type": "string"
          },
          "owned_by": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ],
        "type": "object"
      },
      "ModelList": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Model"
            },
            "type": "array"
          },
          "object": {
            "enum": [
              "list"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [
          "object",
          "data"
        ],
        "type": "object"
      },
      "ResponseMessage": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "nullable": true,
            "type": "string"
          },
          "role": {
            "enum": [
              "assistant"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "type": "object"
      },
      "StreamOptions": {
        "additionalProperties": false,
        "description": "Only valid with stream=true.",
        "properties": {
          "include_obfuscation": {
            "enum": [
              false
            ],
            "type": "boolean",
            "x-go-type": "bool"
          },
          "include_usage": {
            "type": "boolean"
          }
        },
        "required": [],
        "type": "object"
      },
      "TextPart": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text"
            ],
            "type": "string",
            "x-go-type": "string"
          }
        },
        "required": [
          "type",
          "text"
        ],
        "type": "object"
      },
      "Usage": {
        "additionalProperties": false,
        "properties": {
          "completion_tokens": {
            "default": 0,
            "type": "integer"
          },
          "prompt_tokens": {
            "default": 0,
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "type": "integer"
          }
        },
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Test your local Codex and Copilot CLIs through the OpenAI-compatible API. Start with model discovery, then send a buffered or streaming completion. No API key is required: authentication stays with the local CLIs.\n\nSystem/developer messages must precede conversation messages; the last message must be from the user. Only text chat is supported. Tools, images, audio, sampling parameters, and structured output are rejected. Requests are limited to 1 MiB and assistant text to 16 MiB.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "title": "Harness-Gateway",
    "version": "0.1.9",
    "x-upstream-sha256": "0e4dc3d7f52cc7d7c41940587b5ae23c0e3173bd4b4384f9d673ee90185ebafb",
    "x-upstream-source": "https://raw.githubusercontent.com/openai/openai-openapi/85a23866c06a29098083ebb11d5ec70438305def/openapi.json"
  },
  "openapi": "3.0.3",
  "paths": {
    "/health": {
      "get": {
        "description": "Checks gateway liveness. This does not start a CLI or verify upstream authentication.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                },
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The gateway is running."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Non-loopback Host or cross-origin browser request is forbidden."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "HTTP method is not supported for this endpoint.",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods for this endpoint.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Check gateway health",
        "tags": [
          "Gateway"
        ]
      }
    },
    "/v1/chat/completions": {
      "post": {
        "description": "Send text to a local CLI. Choose an example for codex or copilot; set stream=true for incremental output. Model aliases use CLI defaults. Native model IDs come from GET /v1/models. Requests share the configured concurrency limit with model discovery.",
        "operationId": "createChatCompletion",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "codex": {
                  "summary": "codex (buffered)",
                  "value": {
                    "messages": [
                      {
                        "content": "Be brief",
                        "role": "system"
                      },
                      {
                        "content": "Say hello",
                        "role": "user"
                      }
                    ],
                    "model": "codex"
                  }
                },
                "codexStream": {
                  "summary": "codex (streaming)",
                  "value": {
                    "messages": [
                      {
                        "content": "Be brief",
                        "role": "system"
                      },
                      {
                        "content": "Say hello",
                        "role": "user"
                      }
                    ],
                    "model": "codex",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                },
                "copilot": {
                  "summary": "copilot (buffered)",
                  "value": {
                    "messages": [
                      {
                        "content": "Be brief",
                        "role": "system"
                      },
                      {
                        "content": "Say hello",
                        "role": "user"
                      }
                    ],
                    "model": "copilot"
                  }
                },
                "copilotStream": {
                  "summary": "copilot (streaming)",
                  "value": {
                    "messages": [
                      {
                        "content": "Be brief",
                        "role": "system"
                      },
                      {
                        "content": "Say hello",
                        "role": "user"
                      }
                    ],
                    "model": "copilot",
                    "stream": true,
                    "stream_options": {
                      "include_usage": true
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "choices": [
                    {
                      "finish_reason": "stop",
                      "index": 0,
                      "message": {
                        "content": "Hello!",
                        "role": "assistant"
                      }
                    }
                  ],
                  "created": 0,
                  "id": "chatcmpl-example",
                  "model": "codex",
                  "object": "chat.completion"
                },
                "schema": {
                  "$ref": "#/components/schemas/Completion"
                }
              },
              "text/event-stream": {
                "example": "data: {\"id\":\"chatcmpl-example\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"codex\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hello!\"},\"finish_reason\":null}]}\n\ndata: {\"id\":\"chatcmpl-example\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\"codex\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "A buffered completion, or an SSE stream when stream=true. Each SSE data field contains a Chunk JSON object, followed by data: [DONE] on success. An error after streaming starts emits an ErrorResponse and closes without [DONE]. Cancel the browser request to stop its CLI operation.",
            "headers": {
              "X-Request-ID": {
                "description": "Request identifier also recorded in the gateway log.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or unsupported request."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Non-loopback Host or cross-origin browser request is forbidden."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown model or endpoint."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "HTTP method is not supported for this endpoint.",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods for this endpoint.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request exceeds 1 MiB."
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Content-Type must be application/json."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway capacity is full; retry after an active operation finishes."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The local CLI or model discovery failed; check the gateway log."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The gateway is shutting down."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The operation timed out."
          }
        },
        "summary": "Create a chat completion",
        "tags": [
          "Chat"
        ]
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "created": 0,
                      "id": "codex",
                      "object": "model",
                      "owned_by": "codex"
                    },
                    {
                      "created": 0,
                      "id": "copilot",
                      "object": "model",
                      "owned_by": "copilot"
                    }
                  ],
                  "object": "list"
                },
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            },
            "description": "Configured aliases and currently available native model IDs. Discovery uses the local authenticated CLIs."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Non-loopback Host or cross-origin browser request is forbidden."
          },
          "405": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "HTTP method is not supported for this endpoint.",
            "headers": {
              "Allow": {
                "description": "Supported HTTP methods for this endpoint.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway capacity is full; retry after an active operation finishes."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The local CLI or model discovery failed; check the gateway log."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The gateway is shutting down."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The operation timed out."
          }
        },
        "summary": "Discover available models",
        "tags": [
          "Models"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "This gateway (current host and port)",
      "url": "/"
    }
  ],
  "tags": [
